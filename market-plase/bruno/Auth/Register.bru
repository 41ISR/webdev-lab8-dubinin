meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: https://upgraded-funicular-v45r5jjw7492xjr6-5173.app.github.dev/
  body: json
  auth: none
}

body:json {
  {
    "username": "testuser",
    "password": "password123",
    "email": "test@example.com"
  }
}

tests {
  test("Status code is 200 or 201", function() {
    expect([200, 201]).to.include(res.status);
  });
  
  test("Response has token", function() {
    expect(res.body.token).to.be.a('string');
  });
  
  // Сохраняем токен в переменную окружения
  if (res.body.token) {
    bru.setEnvVar("token", res.body.token);
  }
}

docs {
  # Регистрация пользователя
  
  Создает новую учетную запись пользователя.
  
  ## Тело запроса
  - `username` (обязательно) - имя пользователя, минимум 3 символа
  - `password` (обязательно) - пароль, минимум 6 символов
  - `email` (необязательно) - email пользователя
  
  ## Ответ (успех)
  ```json
  {
    "success": true,
    "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
    "user": {
      "id": 1,
      "username": "testuser",
      "email": "test@example.com"
    }
  }
  ```
  
  ## Возможные ошибки
  - 400 - Неверные данные
  - 409 - Пользователь уже существует
}
